---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: 800px;
        max-width: 100%;
        margin: 0 auto;
        padding: 3rem 1rem;
      }
      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 2rem;
        color: rgb(var(--black));
      }
      h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        color: rgb(var(--black));
      }
      p {
        font-size: 1rem;
        line-height: 1.8;
        margin-bottom: 1rem;
        color: rgb(var(--gray-dark));
      }
      strong {
        color: rgb(var(--black));
        font-weight: 600;
      }
      .intro { margin-bottom: 1.5rem; }
      .section { margin-bottom: 2rem; }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
      }
      .tag {
        padding: 0.25rem 0.75rem;
        background: rgb(var(--gray-light));
        border-radius: 4px;
        font-size: 0.875rem;
        color: rgb(var(--gray-dark));
      }

      @media (max-width: 720px) {
        main { 
          padding: 2rem 1rem; 
          width: 100%;
        }
        h1 { 
          font-size: 1.75rem;
          margin-bottom: 1.5rem; 
        }
        h2 { 
          font-size: 1.25rem;
          margin-top: 2rem; 
        }
        p {
          font-size: 0.95rem;
        }
        .tags {
          gap: 0.4rem;
        }
        .tag {
          font-size: 0.8rem;
          padding: 0.2rem 0.6rem;
        }
      }

      @media (max-width: 480px) {
        main { 
          padding: 1.5rem 0.75rem; 
        }
        h1 { 
          font-size: 1.5rem;
        }
        h2 { 
          font-size: 1.1rem;
        }
        .tag {
          font-size: 0.75rem;
          padding: 0.15rem 0.5rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>沈涛</h1>

      <div class="intro">
        <p>
          我是沈涛，一名资深后端工程师，拥有9年工作经验。硕士毕业于
          <strong>浙江大学工程师学院</strong>，专注于
          <strong>高并发架构设计</strong>、<strong>大数据处理</strong> 和
          <strong>风控反作弊系统</strong>建设。目前就职于曹操出行
          （杭州优行科技），负责出行智能研发相关工作。
        </p>
      </div>

      <div class="section">
        <h2>技术栈</h2>
        <div class="tags">
          <!-- Java核心 -->
          <span class="tag">Java</span>
          <span class="tag">JVM</span>
          <span class="tag">多线程并发</span>
          <span class="tag">IO/NIO</span>

          <!-- 后端框架 -->
          <span class="tag">Spring全家桶</span>
          <span class="tag">Dubbo</span>
          <span class="tag">Sentinel</span>
          <span class="tag">MyBatis</span>

          <!-- 数据存储 -->
          <span class="tag">MySQL</span>
          <span class="tag">MongoDB</span>
          <span class="tag">HBase</span>
          <span class="tag">Redis</span>
          <span class="tag">Neo4j</span>
          <span class="tag">Elasticsearch</span>
          <span class="tag">InfluxDB</span>

          <!-- 消息队列 -->
          <span class="tag">Kafka</span>
          <span class="tag">RocketMQ</span>

          <!-- 大数据 -->
          <span class="tag">Hadoop</span>
          <span class="tag">Spark</span>
          <span class="tag">Flink</span>
          <span class="tag">Hive</span>
          <span class="tag">Airflow</span>

          <!-- 编程语言 -->
          <span class="tag">Python</span>
          <span class="tag">Shell</span>
          <span class="tag">JavaScript</span>
          <span class="tag">Vue</span>
          <span class="tag">React</span>

          <!-- 技术前沿 -->
          <span class="tag">LangChain</span>
          <span class="tag">Agent</span>
          <span class="tag">RAG</span>
          <span class="tag">AI编程工具</span>

          <!-- 工程化 -->
          <span class="tag">Git</span>
          <span class="tag">Docker</span>
          <span class="tag">SkyWalking</span>
          <span class="tag">Grafana</span>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
