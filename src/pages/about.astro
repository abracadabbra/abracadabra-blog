---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于我 - ${SITE_TITLE}`} description="个人简介与经历" />
		<style>
			main {
				width: 800px;
				max-width: 100%;
				margin: 0 auto;
				padding: 3rem 1rem;
			}

			h1 {
				font-size: 2rem;
				font-weight: 600;
				margin-bottom: 2rem;
				color: rgb(var(--black));
			}

			h2 {
				font-size: 1.5rem;
				font-weight: 600;
				margin-top: 2.5rem;
				margin-bottom: 1rem;
				color: rgb(var(--black));
				border-bottom: 2px solid rgb(var(--gray-light));
				padding-bottom: 0.5rem;
			}

			h3 {
				font-size: 1.25rem;
				font-weight: 600;
				margin-top: 1.5rem;
				margin-bottom: 0.5rem;
				color: rgb(var(--black));
			}

			p {
				font-size: 1rem;
				line-height: 1.8;
				margin-bottom: 1rem;
				color: rgb(var(--gray-dark));
			}

			em {
				color: var(--ring);
			}

			ul {
				margin-left: 1.5rem;
				margin-bottom: 1rem;
			}

			li {
				margin-bottom: 0.5rem;
				line-height: 1.6;
				color: rgb(var(--gray-dark));
			}

			ul ul {
				margin-top: 0.5rem;
				margin-bottom: 0.5rem;
			}

			@media (max-width: 720px) {
				main {
					padding: 2rem 1rem;
					width: 100%;
				}

				h1 {
					font-size: 1.5rem;
				}

				h2 {
					font-size: 1.25rem;
					margin-top: 2rem;
				}

				h3 {
					font-size: 1.125rem;
					margin-top: 1.25rem;
				}

				p, li {
					font-size: 0.95rem;
				}

				ul {
					margin-left: 1.25rem;
				}
			}

			@media (max-width: 480px) {
				main {
					padding: 1.5rem 0.75rem;
				}

				h1 {
					font-size: 1.25rem;
					margin-bottom: 1.5rem;
				}

				h2 {
					font-size: 1.1rem;
				}

				h3 {
					font-size: 1rem;
				}

				ul {
					margin-left: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>关于我</h1>

			<h2>工作经历</h2>

			<h3>杭州优行科技有限公司（曹操出行） · 出行智能研发部 · 资深工程师</h3>
			<p><em>2020-05 ~ 至今</em></p>
			<ul>
				<li>负责风控反作弊系统的设计与开发，覆盖网约车全场景作弊行为，自2020年以来将资损率从3%降低至0.65%</li>
				<li>主导智能毛利系统建设，成功实现2025年Q4季度净利上岸，日均毛利提升近200万，荣获年度优秀项目</li>
				<li>参与算法工程基础设施的规划与建设，建立模型引擎、实验平台、仿真系统，极大提升模型上线效率</li>
			</ul>

			<h3>杭州微财网络科技有限公司 · 创新业务事业部 · 软件工程师</h3>
			<p><em>2018-05 ~ 2020-05</em></p>
			<ul>
				<li>负责电商"趣淘金"、本地社区"本地万事通"，带领小型团队完成从需求到上线的全流程交付</li>
			</ul>

			<h3>杭州星数科技有限公司 · 基础研发部 · 软件工程师</h3>
			<p><em>2017-06 ~ 2018-05</em></p>
			<ul>
				<li>参与移动私有云管理平台的搭建，深入理解三户模型、产品模型、订单模型等核心业务模型，具备云运营支撑系统开发经验</li>
			</ul>

			<h2>专业技能</h2>
			<ul>
				<li><strong>Java核心</strong>：掌握多线程并发、JVM调优、IO/NIO、集合框架与数据结构，具备线上问题排查、性能诊断与低延时调优经验</li>
				<li><strong>后端框架</strong>：熟悉Spring全家桶，掌握Dubbo服务治理与RPC调用、Sentinel限流降级与熔断等框架与分布式治理组件</li>
				<li><strong>架构设计</strong>：具备中大型项目从0到1架构设计能力，关注通用性、可扩展性与高并发低延时与海量数据处理能力</li>
				<li><strong>数据存储</strong>：熟悉MySQL、MongoDB、HBase、ES、Neo4j、InfluxDB、Redis，掌握多类型数据库选型与海量数据存储优化</li>
				<li><strong>消息队列</strong>：熟悉Kafka与RocketMQ，掌握服务解耦、流量削峰、异步处理等典型使用场景</li>
				<li><strong>大数据</strong>：熟悉Hadoop、Hive、Flink、Spark、Airflow等大数据生态组件，具备实时计算、离线处理与任务调度实践经验</li>
				<li><strong>编程语言</strong>：熟悉Python、Shell、JavaScript(Vue/React)，具备Linux环境下的开发与脚本编写能力</li>
				<li><strong>技术前沿</strong>：熟练使用AI编程工具辅助日常开发，熟悉LangChain/LangGraph框架及Agent、RAG、Prompt等大模型技术原理</li>
			</ul>

			<h2>项目经历</h2>

			<h3>大数据风控反作弊系统 | 技术负责人</h3>
			<p><em>2020-05 ~ 至今</em></p>
			<ul>
				<li><strong>项目描述</strong>：识别、拦截、处置网约车场景下的作弊行为（如乘客逃单、黑产代叫、垃圾注册、营销漏洞、司机刷单、虚假行程等），降低平台资损</li>
				<li><strong>系统架构</strong>：主导风控中台、决策引擎、特征平台、关系图谱、司机作弊、风险感知大盘等子系统从0到1建设</li>
				<li><strong>决策引擎</strong>：基于Sentinel实现多维度限流及核心链路降级预案；自研Chopper脚本引擎，兼容历史Groovy语法，支持热加载与沙箱隔离，规则执行性能提升50%</li>
				<li><strong>特征平台</strong>：统一接入实时特征、离线特征、第三方服务特征、静态配置特征等多种来源；提供表达式引擎支持特征在线加工，接口QPS达万级、毫秒级返回</li>
				<li><strong>风控中台</strong>：支持亿级离线策略仿真历史流量回放，模拟新策略上线后的拦截效果与误伤率；在线AB实验平台支持流量切分、多实验并行</li>
				<li><strong>风险感知</strong>：建设多维度监控体系，覆盖系统层、业务层及各细粒度监控；处罚监控大盘追踪封禁、限流等处置动作，异常波动自动预警</li>
				<li><strong>业务成果</strong>：支撑日均亿级风控请求，99.9%请求在100ms内完成，年度资损率从3%压降至0.65%，累计为平台止损数千万元</li>
			</ul>

			<h3>网约车平台智能毛利管理系统 | 技术负责人</h3>
			<p><em>2023-03 ~ 至今</em></p>
			<ul>
				<li><strong>项目描述</strong>：基于司机弹性与收入约束，实现毛利目标下的实付金额最大化调控系统，支持城市差异化运营策略</li>
				<li><strong>系统架构</strong>：主导毛利系统从0到1建设，构建毛利引擎、策略服务、毛利计算三大核心模块，建立完整的策略决策体系与实时计算能力</li>
				<li><strong>毛利引擎</strong>：基于实付TR限制、IPM策略、非起步费抽成限制等多维度约束，决策订单分润比例，核心链路时延控制在50ms以内</li>
				<li><strong>抽成比例</strong>：将IPM收入、实付收入、平台毛利等口径抽象为独立领域模型，消除原实现中的if-else嵌套与重复计算</li>
				<li><strong>稳定性保障</strong>：基于Sentinel实现限流降级，建立数据监控、离线分析看板与告警体系，关键指标接入实时监控大盘</li>
				<li><strong>业务成果</strong>：通过"策略+系统"双轮驱动，日均毛利增收超179万元，成功实现2025年Q4季度净利上岸，荣获公司年度优秀项目</li>
			</ul>

			<h3>趣淘金App | 技术负责人</h3>
			<p><em>2018-05 ~ 2020-05</em></p>
			<ul>
				<li><strong>项目描述</strong>：趣淘金是一款社交电商导购APP，提供优惠券加高额返佣，拥有互动广告与金币体系。累计注册用户百万，日活10W+</li>
				<li><strong>团队管理</strong>：带领小型团队，采用敏捷开发模式，以双周迭代节奏推进项目，负责需求拆解、任务分配、进度跟踪与风险把控</li>
				<li><strong>技术研发</strong>：负责商品模块（数据清洗与Redis集群预热）、用户模块（账户体系、上级返佣、会员中心）；参与广告、任务、支付、订单相关模块开发</li>
				<li><strong>运维管理</strong>：基于Jenkins与Docker实现自动化部署，通过Eureka Client定制实现无感知上线与灰度发布</li>
			</ul>

			<h2>教育经历</h2>
			<ul>
				<li><strong>浙江大学 · 工程师学院 · 工程管理 · 硕士</strong> (2022-09 ~ 2025-06)
					<ul>
						<li>地点：杭州</li>
					</ul>
				</li>
				<li><strong>浙江大学城市学院 · 计算机学院 · 软件工程 · 本科</strong> (2013-09 ~ 2017-06)
					<ul>
						<li>地点：杭州</li>
					</ul>
				</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
